package vista

import (
	"asistencia/web/plantillas/paginas"
)

templ Seleccion(usuario string, rol string, tokenCSRF string, fecha string, clases []ClaseSeleccionVista, mensajeError string) {
	@paginas.BaseSesion("Asistencia", usuario, rol, tokenCSRF) {
		<div class="flex flex-wrap items-center justify-between gap-3">
			<div>
				<a href="/alumnos" class="text-sm font-medium text-blue-700">← Inicio</a>
				<h1 class="mt-1 text-2xl font-semibold">Asistencia de clase</h1>
				<p class="mt-1 text-sm text-slate-600">Registro personal del docente. El QR de portería sigue siendo la asistencia oficial.</p>
			</div>
		</div>

		if mensajeError != "" {
			<p role="alert" class="mt-4 rounded bg-red-100 p-3 text-red-800">{ mensajeError }</p>
		}

		<form method="get" action="/asistencia" class="mt-6 grid gap-3 rounded border border-slate-200 bg-white p-4 sm:grid-cols-3">
			<label class="block">
				<span class="text-sm font-medium">Fecha</span>
				<input type="date" name="fecha" value={ fecha } class="mt-1 w-full rounded border border-slate-300 p-2"/>
			</label>
			<div class="flex items-end">
				<button type="submit" class="rounded bg-blue-700 px-4 py-2 font-semibold text-white">Ver clases</button>
			</div>
		</form>

		if rol != "docente" {
			<p class="mt-6 rounded border border-amber-200 bg-amber-50 p-4 text-amber-900">
				Como administrador, abra una clase desde la consulta o desde el enlace de una sección.
				La vista de registro está pensada para el docente asignado.
			</p>
		}

		<h2 class="mt-8 text-lg font-semibold">Clases asignadas el { fecha }</h2>
		if len(clases) == 0 {
			<p class="mt-2 text-slate-600">No hay clases asignadas para esa fecha.</p>
		} else {
			<ul class="mt-3 grid gap-3 sm:grid-cols-2">
				for _, clase := range clases {
					<li>
						<a href={ clase.URL } class="block rounded border border-slate-200 bg-white p-4 hover:border-blue-300">
							<span class="font-medium text-blue-800">{ clase.Curso }</span>
							<span class="mt-1 block text-sm text-slate-600">{ clase.Seccion } · bloque { clase.Bloque } · { clase.Horario }</span>
						</a>
					</li>
				}
			</ul>
		}
	}
}
