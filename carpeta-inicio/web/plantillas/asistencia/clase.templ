package vista

import (
	"fmt"

	"asistencia/web/plantillas/paginas"
)

templ Clase(usuario string, rol string, tokenCSRF string, cabecera *ClaseVista, filas []AlumnoFilaVista, estados []EstadoOpcion, mensaje string, mensajeError string) {
	@paginas.BaseSesion("Asistencia de clase", usuario, rol, tokenCSRF) {
		<div class="flex flex-wrap items-center justify-between gap-3">
			<div>
				<a href="/asistencia" class="text-sm font-medium text-blue-700">← Clases</a>
				<h1 class="mt-1 text-2xl font-semibold">Asistencia de clase</h1>
				if cabecera != nil {
					<p class="text-sm text-slate-600">{ cabecera.Curso } · { cabecera.Seccion } · { cabecera.Fecha } · bloque { cabecera.Bloque } ({ cabecera.HoraInicio }–{ cabecera.HoraFin })</p>
				}
			</div>
		</div>

		if mensaje != "" {
			<p role="status" class="mt-4 rounded bg-green-100 p-3 text-green-800">{ mensaje }</p>
		}
		if mensajeError != "" {
			<p role="alert" class="mt-4 rounded bg-red-100 p-3 text-red-800">{ mensajeError }</p>
		}

		if cabecera == nil {
			<p class="mt-6 rounded border border-amber-200 bg-amber-50 p-4 text-amber-900">
				No se pudo abrir la clase. Revise la fecha, la sección, el curso y el bloque.
			</p>
		} else {
			<section id="qr-clase"
				data-fecha={ cabecera.FechaISO }
				data-seccion={ fmt.Sprintf("%d", cabecera.SeccionID) }
				data-curso={ fmt.Sprintf("%d", cabecera.CursoID) }
				data-bloque={ fmt.Sprintf("%d", cabecera.Bloque) }
				class="mt-4 rounded border border-slate-200 bg-white p-4">
				<h2 class="text-base font-semibold">Escanear QR del alumno</h2>
				<p class="mt-1 text-sm text-slate-600">
					Escanee el carné para marcar al alumno como presente. Después presione
					<strong>Guardar asistencia</strong>.
				</p>

				<div class="mt-3 flex flex-wrap gap-2">
					<input id="qr-token" type="text" autocomplete="off" placeholder="Código QR"
						class="min-w-0 flex-1 rounded border border-slate-300 p-2"/>
					<button id="qr-buscar" type="button" class="rounded bg-blue-700 px-4 py-2 font-semibold text-white">
						Marcar presente
					</button>
					<button id="qr-camara" type="button" class="rounded border border-slate-300 px-3 py-2 text-sm font-medium text-slate-700">
						Activar cámara
					</button>
				</div>

				<video id="qr-video" class="mt-3 hidden w-full rounded bg-black" playsinline></video>

				<label class="mt-3 block">
					<span class="text-sm font-medium text-slate-700">O tome una foto del código QR</span>
					<input id="qr-foto" type="file" accept="image/*" capture="environment"
						class="mt-1 block w-full rounded border border-slate-300 p-2 text-sm"/>
				</label>

				<p id="qr-aviso" role="status" class="mt-2 hidden rounded p-2 text-sm"></p>
			</section>

			<div class="mt-4 flex flex-wrap gap-2">
				<form method="post" action="/asistencia/clase/todos">
					<input type="hidden" name="token_csrf" value={ tokenCSRF }/>
					<input type="hidden" name="fecha" value={ cabecera.FechaISO }/>
					<input type="hidden" name="seccion_id" value={ fmt.Sprintf("%d", cabecera.SeccionID) }/>
					<input type="hidden" name="curso_id" value={ fmt.Sprintf("%d", cabecera.CursoID) }/>
					<input type="hidden" name="bloque" value={ fmt.Sprintf("%d", cabecera.Bloque) }/>
					<button type="submit" class="rounded border border-blue-300 bg-blue-50 px-4 py-2 font-semibold text-blue-800">Marcar a todos presentes</button>
				</form>
			</div>

			<form method="post" action="/asistencia/clase" class="mt-6">
				<input type="hidden" name="token_csrf" value={ tokenCSRF }/>
				<input type="hidden" name="fecha" value={ cabecera.FechaISO }/>
				<input type="hidden" name="seccion_id" value={ fmt.Sprintf("%d", cabecera.SeccionID) }/>
				<input type="hidden" name="curso_id" value={ fmt.Sprintf("%d", cabecera.CursoID) }/>
				<input type="hidden" name="bloque" value={ fmt.Sprintf("%d", cabecera.Bloque) }/>

				<div class="overflow-x-auto rounded border border-slate-200 bg-white">
					<table class="w-full text-left text-sm">
						<thead class="bg-slate-100 text-slate-700">
							<tr>
								<th class="p-3">Alumno</th>
								<th class="p-3">Identificador</th>
								<th class="p-3">Ingreso QR</th>
								<th class="p-3">Estado del docente</th>
								<th class="p-3">Observación</th>
							</tr>
						</thead>
						<tbody>
							for _, fila := range filas {
								if fila.Diferencia {
									<tr data-alumno-id={ fmt.Sprintf("%d", fila.ID) } class="border-t border-amber-200 bg-amber-50">
										<td class="p-3 font-medium">{ fila.Nombre }</td>
										<td class="p-3">{ fila.Identificador }</td>
										<td class="p-3">{ fila.QRTexto }</td>
										<td class="p-3">
											<select name={ fmt.Sprintf("estado_%d", fila.ID) } class="w-full rounded border border-slate-300 p-1">
												for _, estado := range estados {
													<option value={ estado.Valor } selected?={ estado.Valor == fila.Estado }>{ estado.Etiqueta }</option>
												}
											</select>
										</td>
										<td class="p-3">
											<input type="text" name={ fmt.Sprintf("observacion_%d", fila.ID) } value={ fila.Observacion } maxlength="300" class="w-full rounded border border-slate-300 p-1"/>
											<span class="block text-xs text-amber-700">Diferencia con el QR</span>
										</td>
									</tr>
								} else {
									<tr data-alumno-id={ fmt.Sprintf("%d", fila.ID) } class="border-t border-slate-100">
										<td class="p-3 font-medium">{ fila.Nombre }</td>
										<td class="p-3">{ fila.Identificador }</td>
										<td class="p-3">{ fila.QRTexto }</td>
										<td class="p-3">
											<select name={ fmt.Sprintf("estado_%d", fila.ID) } class="w-full rounded border border-slate-300 p-1">
												for _, estado := range estados {
													<option value={ estado.Valor } selected?={ estado.Valor == fila.Estado }>{ estado.Etiqueta }</option>
												}
											</select>
										</td>
										<td class="p-3">
											<input type="text" name={ fmt.Sprintf("observacion_%d", fila.ID) } value={ fila.Observacion } maxlength="300" class="w-full rounded border border-slate-300 p-1"/>
										</td>
									</tr>
								}
							}
						</tbody>
					</table>
				</div>
				<div class="mt-4">
					<button type="submit" class="rounded bg-blue-700 px-4 py-2 font-semibold text-white">Guardar asistencia</button>
				</div>
			</form>

			<script src="/estaticos/js/jsqr.js" defer></script>
			<script>
				(function () {
					const seccion = document.getElementById('qr-clase');
					if (!seccion) return;
					const campo = document.getElementById('qr-token');
					const boton = document.getElementById('qr-buscar');
					const botonCamara = document.getElementById('qr-camara');
					const video = document.getElementById('qr-video');
					const foto = document.getElementById('qr-foto');
					const aviso = document.getElementById('qr-aviso');
					const lienzo = document.createElement('canvas');

					const datos = {
						fecha: seccion.dataset.fecha,
						seccion_id: seccion.dataset.seccion,
						curso_id: seccion.dataset.curso,
						bloque: seccion.dataset.bloque,
					};
					const puedeUsarCamara = !!(navigator.mediaDevices && navigator.mediaDevices.getUserMedia);
					const contextoInseguro = !window.isSecureContext;
					let flujo = null;
					let detector = null;
					let animando = false;
					let ultimoCodigo = '';
					let ultimoIntento = 0;

					function mostrar(texto, correcto) {
						aviso.textContent = texto;
						aviso.classList.remove('hidden', 'bg-red-50', 'text-red-800', 'bg-emerald-50', 'text-emerald-800');
						aviso.classList.add(correcto ? 'bg-emerald-50' : 'bg-red-50', correcto ? 'text-emerald-800' : 'text-red-800');
					}

					function detenerCamara() {
						animando = false;
						if (flujo) {
							flujo.getTracks().forEach(function (pista) { pista.stop(); });
							flujo = null;
						}
						video.classList.add('hidden');
					}

					function marcarPresente(alumnoID, nombre) {
						const selector = 'select[name="estado_' + alumnoID + '"]';
						const select = document.querySelector(selector);
						if (!select) {
							mostrar('El alumno no está en la lista de esta clase.', false);
							return;
						}
						select.value = 'presente';
						const fila = select.closest('tr');
						if (fila) {
							fila.classList.add('ring-2', 'ring-emerald-400', 'bg-emerald-50');
							fila.scrollIntoView({ behavior: 'smooth', block: 'center' });
							setTimeout(function () {
								fila.classList.remove('ring-2', 'ring-emerald-400', 'bg-emerald-50');
							}, 2500);
						}
						mostrar(nombre + ' marcado como presente.', true);
					}

					async function buscar(codigo) {
						const limpio = (codigo || '').trim();
						if (!limpio) return;
						const ahora = Date.now();
						if (limpio === ultimoCodigo && ahora - ultimoIntento < 3000) return;
						ultimoCodigo = limpio;
						ultimoIntento = ahora;
						const parametros = new URLSearchParams(datos);
						parametros.set('token', limpio);
						try {
							const respuesta = await fetch('/asistencia/clase/qr?' + parametros.toString(), {
								headers: { Accept: 'application/json' },
							});
							const cuerpo = await respuesta.json().catch(function () { return {}; });
							if (!respuesta.ok) {
								mostrar(cuerpo.error || 'No se pudo leer el código QR.', false);
								return;
							}
							marcarPresente(cuerpo.alumno_id, cuerpo.nombre);
							campo.value = '';
						} catch (error) {
							mostrar('No se pudo consultar el código. Revise la conexión.', false);
						}
					}

					function crearDetector() {
						if (!('BarcodeDetector' in window)) return null;
						try {
							return new BarcodeDetector({ formats: ['qr_code'] });
						} catch (error) {
							return null;
						}
					}

					function decodificarLienzo(ancho, alto) {
						if (typeof window.jsQR !== 'function') return null;
						const contexto = lienzo.getContext('2d', { willReadFrequently: true });
						const imagen = contexto.getImageData(0, 0, ancho, alto);
						const resultado = window.jsQR(imagen.data, ancho, alto, { inversionAttempts: 'attemptBoth' });
						return resultado ? resultado.data : null;
					}

					async function leerVideo() {
						if (!animando) return;
						let codigo = null;
						try {
							if (detector) {
								const codigos = await detector.detect(video);
								if (codigos.length > 0) codigo = codigos[0].rawValue;
							}
							if (!codigo && typeof window.jsQR === 'function' && video.videoWidth > 0) {
								lienzo.width = video.videoWidth;
								lienzo.height = video.videoHeight;
								lienzo.getContext('2d', { willReadFrequently: true }).drawImage(video, 0, 0, lienzo.width, lienzo.height);
								codigo = decodificarLienzo(lienzo.width, lienzo.height);
							}
						} catch (error) {
							codigo = null;
						}
						if (codigo) {
							await buscar(codigo);
						}
						if (animando) setTimeout(leerVideo, 250);
					}

					async function activarCamara() {
						if (!puedeUsarCamara || contextoInseguro) {
							mostrar('La cámara en vivo no está disponible por HTTP. Use "Tomar foto" o un lector USB, o abra la página por HTTPS.', false);
							return;
						}
						try {
							flujo = await navigator.mediaDevices.getUserMedia({ video: { facingMode: { ideal: 'environment' } } });
							video.srcObject = flujo;
							video.classList.remove('hidden');
							await video.play();
							detector = crearDetector();
							animando = true;
							leerVideo();
						} catch (error) {
							mostrar('No se pudo activar la cámara. Revise los permisos o use "Tomar foto".', false);
						}
					}

					function cargarImagen(archivo) {
						if ('createImageBitmap' in window) {
							return createImageBitmap(archivo);
						}
						return new Promise(function (resolver, rechazar) {
							const imagen = new Image();
							imagen.onload = function () { resolver(imagen); };
							imagen.onerror = rechazar;
							imagen.src = URL.createObjectURL(archivo);
						});
					}

					async function leerFoto(archivo) {
						try {
							if (typeof window.jsQR !== 'function') {
								mostrar('No se pudo cargar el lector de QR. Recargue la página.', false);
								return;
							}
							const imagen = await cargarImagen(archivo);
							lienzo.width = imagen.width;
							lienzo.height = imagen.height;
							lienzo.getContext('2d', { willReadFrequently: true }).drawImage(imagen, 0, 0, imagen.width, imagen.height);
							const codigo = decodificarLienzo(imagen.width, imagen.height);
							if (!codigo) {
								mostrar('No se encontró un código QR en la imagen. Intente con más luz.', false);
								return;
							}
							await buscar(codigo);
						} catch (error) {
							mostrar('No se pudo leer la imagen. Intente de nuevo.', false);
						} finally {
							foto.value = '';
						}
					}

					boton.addEventListener('click', function () { buscar(campo.value); });
					campo.addEventListener('keydown', function (evento) {
						if (evento.key === 'Enter') {
							evento.preventDefault();
							buscar(campo.value);
						}
					});
					botonCamara.addEventListener('click', activarCamara);
					foto.addEventListener('change', function () {
						const archivo = foto.files && foto.files[0];
						if (archivo) leerFoto(archivo);
					});

					if (!puedeUsarCamara || contextoInseguro) {
						botonCamara.classList.add('hidden');
						mostrar('Para escanear en vivo abra la página por HTTPS. Mientras tanto, use "Tomar foto" o un lector USB.', false);
					}
				}());
			</script>
		}
	}
}
