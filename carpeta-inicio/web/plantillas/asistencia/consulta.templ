package vista

import (
	"fmt"

	"asistencia/web/plantillas/paginas"
)

templ Consulta(usuario string, rol string, tokenCSRF string, fecha string, secciones []SeccionOpcion, seccionID int64, filas []ConsultaFilaVista, mensaje string, mensajeError string) {
	@paginas.BaseSesion("Consulta de asistencia", usuario, rol, tokenCSRF) {
		<div class="flex flex-wrap items-center justify-between gap-3">
			<div>
				<a href="/alumnos" class="text-sm font-medium text-blue-700">← Inicio</a>
				<h1 class="mt-1 text-2xl font-semibold">Consulta de asistencia</h1>
				<p class="mt-1 text-sm text-slate-600">Registros del docente y contraste con el QR. El QR es la asistencia oficial.</p>
			</div>
		</div>

		if mensaje != "" {
			<p role="status" class="mt-4 rounded bg-green-100 p-3 text-green-800">{ mensaje }</p>
		}
		if mensajeError != "" {
			<p role="alert" class="mt-4 rounded bg-red-100 p-3 text-red-800">{ mensajeError }</p>
		}

		<form method="get" action="/asistencia/consulta" class="mt-6 grid gap-3 rounded border border-slate-200 bg-white p-4 sm:grid-cols-4">
			<label class="block">
				<span class="text-sm font-medium">Fecha</span>
				<input type="date" name="fecha" value={ fecha } class="mt-1 w-full rounded border border-slate-300 p-2"/>
			</label>
			<label class="block sm:col-span-2">
				<span class="text-sm font-medium">Sección</span>
				<select name="seccion_id" class="mt-1 w-full rounded border border-slate-300 p-2">
					<option value="">Seleccione una sección</option>
					for _, seccion := range secciones {
						<option value={ fmt.Sprintf("%d", seccion.ID) } selected?={ seccion.ID == seccionID }>{ seccion.Etiqueta }</option>
					}
				</select>
			</label>
			<div class="flex items-end">
				<button type="submit" class="rounded bg-blue-700 px-4 py-2 font-semibold text-white">Consultar</button>
			</div>
		</form>

		if seccionID > 0 {
			<h2 class="mt-8 text-lg font-semibold">Registros de la sección</h2>
			if len(filas) == 0 {
				<p class="mt-2 text-slate-600">No hay registros del docente para esa fecha.</p>
			} else {
				<div class="mt-3 overflow-x-auto rounded border border-slate-200 bg-white">
					<table class="w-full text-left text-sm">
						<thead class="bg-slate-100 text-slate-700">
							<tr>
								<th class="p-3">Alumno</th>
								<th class="p-3">Curso</th>
								<th class="p-3">Bloque</th>
								<th class="p-3">Estado</th>
								<th class="p-3">QR</th>
								<th class="p-3">Docente</th>
								<th class="p-3">Observación</th>
								if rol == "administrador" {
									<th class="p-3">Corrección</th>
								}
							</tr>
						</thead>
						<tbody>
							for _, fila := range filas {
								if fila.Diferencia {
									<tr class="border-t border-amber-200 bg-amber-50 align-top">
										<td class="p-3 font-medium">{ fila.Alumno }</td>
										<td class="p-3">{ fila.Curso }</td>
										<td class="p-3">{ fila.Bloque }</td>
										<td class="p-3">{ fila.Estado }</td>
										<td class="p-3">{ fila.QRTexto }</td>
										<td class="p-3">{ fila.Docente }</td>
										<td class="p-3">{ fila.Observacion }</td>
										if rol == "administrador" {
											<td class="p-3">@formularioCorreccion(fila, tokenCSRF, fecha, seccionID)</td>
										}
									</tr>
								} else {
									<tr class="border-t border-slate-100 align-top">
										<td class="p-3 font-medium">{ fila.Alumno }</td>
										<td class="p-3">{ fila.Curso }</td>
										<td class="p-3">{ fila.Bloque }</td>
										<td class="p-3">{ fila.Estado }</td>
										<td class="p-3">{ fila.QRTexto }</td>
										<td class="p-3">{ fila.Docente }</td>
										<td class="p-3">{ fila.Observacion }</td>
										if rol == "administrador" {
											<td class="p-3">@formularioCorreccion(fila, tokenCSRF, fecha, seccionID)</td>
										}
									</tr>
								}
							}
						</tbody>
					</table>
				</div>
			}
		}
	}
}

templ formularioCorreccion(fila ConsultaFilaVista, tokenCSRF string, fecha string, seccionID int64) {
	<form method="post" action="/asistencia/consulta/correccion" class="grid gap-1">
		<input type="hidden" name="token_csrf" value={ tokenCSRF }/>
		<input type="hidden" name="registro_id" value={ fmt.Sprintf("%d", fila.ID) }/>
		<input type="hidden" name="fecha" value={ fecha }/>
		<input type="hidden" name="seccion_id" value={ fmt.Sprintf("%d", seccionID) }/>
		<select name="estado" class="rounded border border-slate-300 p-1">
			<option value="presente" selected?={ fila.Estado == "presente" }>Presente</option>
			<option value="tardanza" selected?={ fila.Estado == "tardanza" }>Tardanza</option>
			<option value="falta" selected?={ fila.Estado == "falta" }>Falta</option>
			<option value="falta_justificada" selected?={ fila.Estado == "falta_justificada" }>Falta justificada</option>
		</select>
		<input type="text" name="observacion" value={ fila.Observacion } maxlength="300" placeholder="Observación" class="rounded border border-slate-300 p-1"/>
		<input type="text" name="motivo" required placeholder="Motivo de la corrección" class="rounded border border-slate-300 p-1"/>
		<button type="submit" class="rounded border border-slate-300 px-3 py-1 font-medium">Corregir</button>
	</form>
}
