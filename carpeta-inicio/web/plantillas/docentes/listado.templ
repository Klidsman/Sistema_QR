package vista

import (
	"fmt"

	"asistencia/web/plantillas/paginas"
)

templ Listado(usuario string, rol string, tokenCSRF string, docentes []DocenteVista, mensaje string, mensajeError string) {
	@paginas.BaseSesion("Docentes", usuario, rol, tokenCSRF) {
		<div class="flex flex-wrap items-center justify-between gap-3">
			<div>
				<a href="/alumnos" class="text-sm font-medium text-blue-700">← Inicio</a>
				<h1 class="mt-1 text-2xl font-semibold">Docentes</h1>
			</div>
		</div>

		if mensaje != "" {
			<p role="status" class="mt-4 rounded bg-green-100 p-3 text-green-800">{ mensaje }</p>
		}
		if mensajeError != "" {
			<p role="alert" class="mt-4 rounded bg-red-100 p-3 text-red-800">{ mensajeError }</p>
		}

		if rol == "administrador" {
			<form method="post" action="/docentes" class="mt-6 grid gap-4 rounded border border-slate-200 bg-white p-4 sm:grid-cols-2 lg:grid-cols-4">
				<input type="hidden" name="token_csrf" value={ tokenCSRF }/>
				<label class="block">
					<span class="text-sm font-medium">Nombre completo *</span>
					<input type="text" name="nombre" required class="mt-1 w-full rounded border border-slate-300 p-2"/>
				</label>
				<label class="block">
					<span class="text-sm font-medium">Correo *</span>
					<input type="email" name="correo" required class="mt-1 w-full rounded border border-slate-300 p-2"/>
				</label>
				<label class="block">
					<span class="text-sm font-medium">Contraseña *</span>
					<input type="password" name="contrasenia" minlength="8" required class="mt-1 w-full rounded border border-slate-300 p-2"/>
				</label>
				<div class="flex items-end">
					<button type="submit" class="rounded bg-blue-700 px-4 py-2 font-semibold text-white">Crear docente</button>
				</div>
			</form>
		}

		<h2 class="mt-8 text-lg font-semibold">Cuentas de docente</h2>
		if len(docentes) == 0 {
			<p class="mt-2 text-slate-600">Todavía no hay docentes registrados.</p>
		} else {
			<div class="mt-3 overflow-x-auto rounded border border-slate-200 bg-white">
				<table class="w-full text-left text-sm">
					<thead class="bg-slate-100 text-slate-700">
						<tr>
							<th class="p-3">Nombre</th>
							<th class="p-3">Correo</th>
							<th class="p-3">Estado</th>
							if rol == "administrador" {
								<th class="p-3">Acciones</th>
							}
						</tr>
					</thead>
					<tbody>
						for _, docente := range docentes {
							<tr class="border-t border-slate-100 align-top">
								<td class="p-3 font-medium">{ docente.Nombre }</td>
								<td class="p-3">{ docente.Correo }</td>
								<td class="p-3">{ estadoDocente(docente.Activo) }</td>
								if rol == "administrador" {
									<td class="p-3">
										<div class="flex flex-wrap items-end gap-2">
											<form method="post" action={ fmt.Sprintf("/docentes/%d/clave", docente.ID) } class="flex items-end gap-2">
												<input type="hidden" name="token_csrf" value={ tokenCSRF }/>
												<label class="block">
													<span class="text-xs text-slate-500">Nueva clave</span>
													<input type="password" name="contrasenia" minlength="8" required class="rounded border border-slate-300 p-1"/>
												</label>
												<button type="submit" class="rounded border border-slate-300 px-3 py-1 font-medium">Restablecer</button>
											</form>
											if docente.Activo {
												<form method="post" action={ fmt.Sprintf("/docentes/%d/desactivacion", docente.ID) } onsubmit="return confirm('La cuenta dejará de poder ingresar. ¿Continuar?');">
													<input type="hidden" name="token_csrf" value={ tokenCSRF }/>
													<button type="submit" class="rounded border border-amber-300 px-3 py-1 font-medium text-amber-800">Desactivar</button>
												</form>
											}
										</div>
									</td>
								}
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
	}
}

func estadoDocente(activo bool) string {
	if activo {
		return "Activo"
	}
	return "Inactivo"
}
