package vista

import "fmt"

templ Carnet(alumno Alumno, anchoMM int, altoMM int) {
	<article class="carnet" style={ fmt.Sprintf("width: %dmm; height: %dmm; break-inside: avoid; page-break-inside: avoid;", anchoMM, altoMM) }>
		<div style="display: flex; width: 100%; height: 100%; overflow: hidden; border: 0.3mm solid #cbd5e1; border-radius: 2mm; background: #ffffff; color: #0f172a; font-family: Arial, Helvetica, sans-serif;">
			<div style="width: 24mm; flex: none; background: #e2e8f0;">
				if alumno.TieneFoto {
					<img src={ fmt.Sprintf("/alumnos/%d/foto", alumno.ID) } alt={ "Foto de " + alumno.NombreCompleto() } style="display: block; width: 100%; height: 100%; object-fit: cover;"/>
				} else {
					<div style="display: flex; width: 100%; height: 100%; align-items: center; justify-content: center; text-align: center; font-size: 2.6mm; font-weight: 700; color: #475569;">Sin foto</div>
				}
			</div>
			<div style="display: flex; min-width: 0; flex: 1; flex-direction: column; justify-content: space-between; padding: 2mm;">
				<div>
					<p style="margin: 0; font-size: 2.1mm; font-weight: 700; letter-spacing: 0.4mm; color: #1d4ed8; text-transform: uppercase;">Carné escolar</p>
					<p style="margin: 1mm 0 0; font-size: 3.2mm; font-weight: 700; line-height: 1.1; overflow-wrap: anywhere;">{ alumno.NombreCompleto() }</p>
					<p style="margin: 1mm 0 0; font-size: 2.6mm; font-weight: 600;">{ alumno.Grado } { alumno.Seccion } · { alumno.AnioEscolar }</p>
					<p style="margin: 0.5mm 0 0; font-size: 2.3mm; color: #475569;">DNI { alumno.Identificador }</p>
				</div>
				<div style="display: flex; align-items: flex-end; justify-content: space-between; gap: 2mm;">
					<p style="margin: 0; font-size: 1.9mm; color: #64748b;">Presente este carné al ingresar.</p>
					<img src={ fmt.Sprintf("/alumnos/%d/qr/imagen", alumno.ID) } alt={ "Código QR de " + alumno.NombreCompleto() } style="display: block; width: 15mm; height: 15mm; flex: none;"/>
				</div>
			</div>
		</div>
	</article>
}
