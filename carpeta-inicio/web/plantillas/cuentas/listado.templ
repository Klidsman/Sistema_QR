package cuentas

import (
	"fmt"

	"asistencia/web/plantillas/paginas"
)

templ Listado(datos Datos) {
	@paginas.BaseSesion(datos.Titulo, datos.Usuario, datos.RolSesion, datos.TokenCSRF) {
		<div class="flex flex-wrap items-center justify-between gap-3">
			<div>
				<a href="/alumnos" class="text-sm font-medium text-blue-700">← Inicio</a>
				<h1 class="mt-1 text-2xl font-semibold">{ datos.Titulo }</h1>
			</div>
		</div>

		if datos.Mensaje != "" {
			<p role="status" class="mt-4 rounded bg-green-100 p-3 text-green-800">{ datos.Mensaje }</p>
		}
		if datos.MensajeError != "" {
			<p role="alert" class="mt-4 rounded bg-red-100 p-3 text-red-800">{ datos.MensajeError }</p>
		}

		if datos.PuedeEscribir {
			<form method="post" action={ datos.RutaBase } class="mt-6 grid gap-4 rounded border border-slate-200 bg-white p-4 sm:grid-cols-2 lg:grid-cols-4">
				<input type="hidden" name="token_csrf" value={ datos.TokenCSRF }/>
				<label class="block">
					<span class="text-sm font-medium">Nombre completo *</span>
					<input type="text" name="nombre" required class="mt-1 w-full rounded border border-slate-300 p-2"/>
				</label>
				<label class="block">
					<span class="text-sm font-medium">Correo *</span>
					<input type="email" name="correo" required class="mt-1 w-full rounded border border-slate-300 p-2"/>
				</label>
				<label class="block">
					<span class="text-sm font-medium">Contraseña *</span>
					<input type="password" name="contrasenia" minlength="8" required class="mt-1 w-full rounded border border-slate-300 p-2"/>
				</label>
				<div class="flex items-end">
					<button type="submit" class="rounded bg-blue-700 px-4 py-2 font-semibold text-white">{ datos.BotonCrear }</button>
				</div>
			</form>
		}

		<h2 class="mt-8 text-lg font-semibold">Cuentas de { datos.Singular }</h2>
		if len(datos.Cuentas) == 0 {
			<p class="mt-2 text-slate-600">Todavía no hay { datos.Singular }s registrados.</p>
		} else {
			<div class="mt-3 overflow-x-auto rounded border border-slate-200 bg-white">
				<table class="w-full text-left text-sm">
					<thead class="bg-slate-100 text-slate-700">
						<tr>
							<th class="p-3">Nombre</th>
							<th class="p-3">Correo</th>
							<th class="p-3">Estado</th>
							if datos.PuedeEscribir {
								<th class="p-3">Acciones</th>
							}
						</tr>
					</thead>
					<tbody>
						for _, cuenta := range datos.Cuentas {
							<tr class="border-t border-slate-100 align-top">
								<td class="p-3 font-medium">{ cuenta.Nombre }</td>
								<td class="p-3">{ cuenta.Correo }</td>
								<td class="p-3">{ estadoCuenta(cuenta.Activo) }</td>
								if datos.PuedeEscribir {
									<td class="p-3">
										<div class="flex flex-wrap items-end gap-2">
											<form method="post" action={ fmt.Sprintf("%s/%d/clave", datos.RutaBase, cuenta.ID) } class="flex items-end gap-2">
												<input type="hidden" name="token_csrf" value={ datos.TokenCSRF }/>
												<label class="block">
													<span class="text-xs text-slate-500">Nueva clave</span>
													<input type="password" name="contrasenia" minlength="8" required class="rounded border border-slate-300 p-1"/>
												</label>
												<button type="submit" class="rounded border border-slate-300 px-3 py-1 font-medium">Restablecer</button>
											</form>
											if cuenta.Activo {
												<form method="post" action={ fmt.Sprintf("%s/%d/desactivacion", datos.RutaBase, cuenta.ID) } onsubmit="return confirm('La cuenta dejará de poder ingresar. ¿Continuar?');">
													<input type="hidden" name="token_csrf" value={ datos.TokenCSRF }/>
													<button type="submit" class="rounded border border-amber-300 px-3 py-1 font-medium text-amber-800">Desactivar</button>
												</form>
											}
										</div>
									</td>
								}
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
	}
}

func estadoCuenta(activo bool) string {
	if activo {
		return "Activo"
	}
	return "Inactivo"
}
