package vista

import (
	"strconv"

	"asistencia/internal/academico"
	"asistencia/web/plantillas/paginas"
)

templ Formulario(usuario string, rol string, tokenCSRF string, secciones []academico.Seccion, formulario DatosFormulario, mensajeError string) {
	@paginas.BaseSesion(tituloFormulario(formulario), usuario, rol, tokenCSRF) {
		<div class="flex items-center justify-between gap-3">
			<h1 class="text-2xl font-semibold">{ tituloFormulario(formulario) }</h1>
			<a href="/alumnos" class="rounded border border-slate-300 px-4 py-2 font-medium">Volver</a>
		</div>

		if mensajeError != "" {
			<p role="alert" class="mt-4 rounded bg-red-100 p-3 text-red-800">{ mensajeError }</p>
		}

		<form method="post" action={ accionFormulario(formulario) } enctype="multipart/form-data" class="mt-6 grid gap-4 rounded border border-slate-200 bg-white p-4 sm:grid-cols-2">
			<input type="hidden" name="token_csrf" value={ tokenCSRF }/>

			<label class="block">
				<span class="text-sm font-medium">DNI o código *</span>
				<input type="text" name="identificador" value={ formulario.Identificador } required?={ !formulario.EsEdicion } readonly?={ formulario.EsEdicion } class="mt-1 w-full rounded border border-slate-300 p-2"/>
				if formulario.EsEdicion {
					<p class="mt-1 text-xs text-slate-500">El DNI o código no se puede cambiar.</p>
				}
				if formulario.TieneErrores() {
					<p class="mt-1 text-sm text-red-700">{ formulario.ErrorDe("identificador") }</p>
				}
			</label>

			<label class="block">
				<span class="text-sm font-medium">Grado y sección *</span>
				<select name="seccion_id" required class="mt-1 w-full rounded border border-slate-300 p-2">
					<option value="">Seleccione una sección</option>
					for _, seccion := range secciones {
						<option value={ strconv.FormatInt(seccion.ID, 10) } selected?={ seccion.ID == formulario.SeccionID }>{ seccion.Etiqueta() }</option>
					}
				</select>
				if formulario.TieneErrores() {
					<p class="mt-1 text-sm text-red-700">{ formulario.ErrorDe("seccion_id") }</p>
				}
			</label>

			<label class="block">
				<span class="text-sm font-medium">Nombres *</span>
				<input type="text" name="nombres" value={ formulario.Nombres } required class="mt-1 w-full rounded border border-slate-300 p-2"/>
				if formulario.TieneErrores() {
					<p class="mt-1 text-sm text-red-700">{ formulario.ErrorDe("nombres") }</p>
				}
			</label>

			<label class="block">
				<span class="text-sm font-medium">Apellidos *</span>
				<input type="text" name="apellidos" value={ formulario.Apellidos } required class="mt-1 w-full rounded border border-slate-300 p-2"/>
				if formulario.TieneErrores() {
					<p class="mt-1 text-sm text-red-700">{ formulario.ErrorDe("apellidos") }</p>
				}
			</label>

			<label class="block">
				<span class="text-sm font-medium">Nombre del apoderado</span>
				<input type="text" name="apoderado_nombre" value={ formulario.ApoderadoNombre } class="mt-1 w-full rounded border border-slate-300 p-2"/>
			</label>

			<label class="block">
				<span class="text-sm font-medium">Teléfono del apoderado</span>
				<input type="tel" name="apoderado_telefono" value={ formulario.ApoderadoTelefono } class="mt-1 w-full rounded border border-slate-300 p-2"/>
			</label>

			<label class="block sm:col-span-2">
				<span class="text-sm font-medium">Foto (JPG o PNG, opcional)</span>
				<input type="file" name="foto" accept="image/jpeg,image/png" class="mt-1 w-full rounded border border-slate-300 p-2"/>
				if formulario.EsEdicion {
					<p class="mt-1 text-xs text-slate-500">Si no elige un archivo, se conserva la foto actual.</p>
				}
			</label>

			<div class="flex gap-3 sm:col-span-2">
				<button type="submit" class="rounded bg-blue-700 px-4 py-2 font-semibold text-white">Guardar</button>
				<a href="/alumnos" class="rounded border border-slate-300 px-4 py-2 font-medium">Cancelar</a>
			</div>
		</form>
	}
}

func tituloFormulario(formulario DatosFormulario) string {
	if formulario.EsEdicion {
		return "Editar alumno"
	}
	return "Nuevo alumno"
}

func accionFormulario(formulario DatosFormulario) string {
	if formulario.EsEdicion {
		return "/alumnos/" + strconv.FormatInt(formulario.ID, 10)
	}
	return "/alumnos"
}
