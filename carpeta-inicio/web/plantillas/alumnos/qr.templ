package vista

import "fmt"

templ SeccionQR(alumno Alumno, credencial *Credencial, historial []Credencial, rol string, tokenCSRF string) {
	<section class="mt-6 rounded border border-slate-200 bg-white p-4">
		<h2 class="text-lg font-semibold">Código QR</h2>

		if !alumno.Activo() {
			<p class="mt-3 rounded bg-slate-100 p-3 text-slate-600">El alumno no está activo, así que no puede tener un QR vigente.</p>
		} else if credencial == nil {
			<p class="mt-3 text-slate-600">Este alumno todavía no tiene un QR vigente.</p>
			if rol == "administrador" {
				<form method="post" action={ fmt.Sprintf("/alumnos/%d/qr", alumno.ID) } class="mt-3">
					<input type="hidden" name="token_csrf" value={ tokenCSRF }/>
					<button type="submit" class="rounded bg-blue-700 px-4 py-2 font-semibold text-white">Generar QR</button>
				</form>
			}
		} else {
			<div class="mt-3 flex flex-col gap-4 sm:flex-row sm:items-start">
				<img src={ fmt.Sprintf("/alumnos/%d/qr/imagen", alumno.ID) } alt="Código QR del alumno" class="h-48 w-48 rounded border border-slate-200 bg-white p-2"/>
				<div class="space-y-3">
					<div>
						<p class="text-sm text-slate-500">Estado</p>
						<p class="font-medium">{ credencial.Estado }</p>
					</div>
					<div>
						<p class="text-sm text-slate-500">Emitido</p>
						<p class="font-medium">{ credencial.EmitidaEn }</p>
					</div>
					if rol == "administrador" && credencial.Token != "" {
						<details class="text-sm">
							<summary class="cursor-pointer font-medium text-blue-700">Código de respaldo</summary>
							<code class="mt-1 block break-all rounded bg-slate-100 p-2 text-xs">{ credencial.Token }</code>
						</details>
					}
					if rol == "administrador" {
						<form method="post" action={ fmt.Sprintf("/alumnos/%d/qr/reemplazo", alumno.ID) } class="rounded border border-amber-200 bg-amber-50 p-3">
							<input type="hidden" name="token_csrf" value={ tokenCSRF }/>
							<label class="block">
								<span class="text-sm font-medium">Motivo del reemplazo</span>
								<select name="motivo" required class="mt-1 w-full rounded border border-slate-300 p-2">
									<option value="">Seleccione un motivo</option>
									<option value="perdida">Pérdida</option>
									<option value="robo">Robo</option>
									<option value="otro">Otro</option>
								</select>
							</label>
							<button type="submit" class="mt-2 rounded bg-amber-700 px-4 py-2 text-sm font-semibold text-white" onclick="return confirm('El QR actual dejará de funcionar de inmediato. ¿Continuar?');">Reemplazar QR</button>
						</form>
					}
				</div>
			</div>
		}

		if len(historial) > 0 {
			<h3 class="mt-6 text-base font-semibold">Historial de códigos QR</h3>
			<div class="mt-2 overflow-x-auto">
				<table class="w-full text-left text-sm">
					<thead class="bg-slate-100 text-slate-700">
						<tr>
							<th class="p-2">Estado</th>
							<th class="p-2">Emitido</th>
							<th class="p-2">Revocado</th>
							<th class="p-2">Motivo</th>
						</tr>
					</thead>
					<tbody>
						for _, credencial := range historial {
							<tr class="border-t border-slate-100">
								<td class="p-2">{ credencial.Estado }</td>
								<td class="p-2">{ credencial.EmitidaEn }</td>
								<td class="p-2">{ credencial.RevocadaEn }</td>
								<td class="p-2">{ credencial.Motivo }</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
	</section>
}
