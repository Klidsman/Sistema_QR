package paginas

templ Base(titulo string) {
	<!DOCTYPE html>
	<html lang="es">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ titulo } · Asistencia</title>
			<link rel="stylesheet" href="/estaticos/css/app.css"/>
			<script src="/estaticos/js/htmx.min.js" defer></script>
		</head>
		<body class="min-h-screen bg-slate-50 text-slate-900 antialiased">
			{ children... }
		</body>
	</html>
}

templ BaseSesion(titulo string, nombre string, rol string, tokenCSRF string) {
	<!DOCTYPE html>
	<html lang="es">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ titulo } · Asistencia</title>
			<link rel="stylesheet" href="/estaticos/css/app.css"/>
			<script src="/estaticos/js/htmx.min.js" defer></script>
		</head>
		<body class="min-h-screen bg-slate-50 text-slate-900 antialiased">
			<header class="border-b border-slate-200 bg-white">
				<div class="mx-auto w-full max-w-6xl p-4">
					<div class="flex flex-wrap items-center justify-between gap-3">
						<a href={ EnlaceInicio(rol) } class="text-lg font-semibold text-blue-800">Asistencia</a>
						<div class="flex flex-wrap items-center justify-end gap-3 text-sm">
							<span class="text-slate-600">{ nombre } · { rol }</span>
							if rol == "administrador" || rol == "docente" || rol == "porteria" {
								<a id="indicador-alertas"
									href="/alertas"
									hx-get="/alertas/indicador"
									hx-trigger="load, every 60s"
									hx-swap="outerHTML"
									class="inline-flex items-center gap-2 rounded-full bg-blue-50 px-3 py-1 font-medium text-blue-800">
									Alertas
									<span class="rounded-full bg-blue-700 px-2 py-0.5 text-xs font-semibold text-white">0</span>
								</a>
							}
							<form method="post" action="/salir">
								<input type="hidden" name="token_csrf" value={ tokenCSRF }/>
								<button type="submit" class="rounded border border-slate-300 px-3 py-1 font-medium text-slate-700">Salir</button>
							</form>
						</div>
					</div>

					<nav class="mt-3 flex flex-wrap gap-x-4 gap-y-2 border-t border-slate-100 pt-3 text-sm">
						if rol == "administrador" || rol == "director" {
							<a href="/alumnos" class="font-medium text-slate-700 hover:text-blue-700">Alumnos</a>
							<a href="/configuracion" class="font-medium text-slate-700 hover:text-blue-700">Configuración</a>
						}
						if rol == "administrador" {
							<a href="/docentes" class="font-medium text-slate-700 hover:text-blue-700">Docentes</a>
							<a href="/porteros" class="font-medium text-slate-700 hover:text-blue-700">Porteros</a>
							<a href="/carnets" class="font-medium text-slate-700 hover:text-blue-700">Carnés</a>
						}
						if rol == "administrador" || rol == "director" || rol == "docente" {
							<a href="/asistencia" class="font-medium text-slate-700 hover:text-blue-700">Asistencia</a>
						}
						if rol == "administrador" || rol == "director" {
							<a href="/asistencia/asignaciones" class="font-medium text-slate-700 hover:text-blue-700">Asignaciones</a>
							<a href="/asistencia/consulta" class="font-medium text-slate-700 hover:text-blue-700">Consulta de asistencia</a>
						}
						if rol == "administrador" || rol == "porteria" {
							<a href="/porteria" class="font-medium text-slate-700 hover:text-blue-700">Portería</a>
						}
						if rol == "administrador" || rol == "director" || rol == "docente" {
							<a href="/justificaciones" class="font-medium text-slate-700 hover:text-blue-700">Justificaciones</a>
							<a href="/reportes/diario" class="font-medium text-slate-700 hover:text-blue-700">Reportes</a>
							<a href="/reportes/panel" class="font-medium text-slate-700 hover:text-blue-700">Panel del día</a>
							<a href="/reportes/resumen" class="font-medium text-slate-700 hover:text-blue-700">Resumen</a>
							<a href="/reportes/reiteracion" class="font-medium text-slate-700 hover:text-blue-700">Reiteración</a>
						}
					</nav>
				</div>
			</header>
			<main class="mx-auto w-full max-w-6xl p-4 sm:p-6">
				{ children... }
			</main>
		</body>
	</html>
}
