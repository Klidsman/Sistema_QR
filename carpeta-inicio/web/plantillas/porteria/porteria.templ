package porteria

import "asistencia/web/plantillas/paginas"

templ Porteria(usuario string, rol string, tokenCSRF string, resultado *Resultado) {
	@paginas.BaseSesion("Portería", usuario, rol, tokenCSRF) {
		<div class="mx-auto max-w-2xl">
			<h1 class="text-2xl font-semibold text-slate-900">Registro de ingreso</h1>
			<p class="mt-1 text-sm text-slate-600">Escanee el código QR del carné o pegue su contenido.</p>

			if resultado != nil {
				if resultado.Registrado {
					<div role="status" class="mt-4 rounded border border-emerald-200 bg-emerald-50 p-4">
						<p class="text-lg font-semibold text-emerald-900">{ resultado.Alumno }</p>
						<p class="text-sm text-emerald-800">{ resultado.Identificador } · { resultado.Seccion }</p>
						<p class="mt-2 text-sm text-emerald-800">Hora { resultado.Hora } · <strong>{ resultado.Estado }</strong></p>
					</div>
				} else {
					<div role="alert" class="mt-4 rounded border border-red-200 bg-red-50 p-4 text-red-800">
						{ resultado.Motivo }
					</div>
				}
			}

			<form id="formulario-porteria" method="post" action="/porteria/ingreso" class="mt-6 rounded border border-slate-200 bg-white p-4">
				<input type="hidden" name="token_csrf" value={ tokenCSRF }/>
				<label class="block">
					<span class="text-sm font-medium text-slate-700">Código QR *</span>
					<input id="token" name="token" required autofocus autocomplete="off"
						class="mt-1 w-full rounded border border-slate-300 p-3 text-lg"/>
				</label>
				<button type="submit" class="mt-3 w-full rounded bg-blue-700 px-4 py-3 font-semibold text-white">Registrar ingreso</button>
			</form>

			<section class="mt-4 rounded border border-slate-200 bg-white p-4">
				<h2 class="text-base font-semibold">Cámara o escáner</h2>

				<video id="camara" class="mt-2 hidden w-full rounded bg-black" playsinline></video>
				<button id="activar-camara" type="button" class="mt-2 rounded border border-slate-300 px-3 py-2 text-sm font-medium text-slate-700">
					Activar cámara
				</button>

				<label class="mt-3 block">
					<span class="text-sm font-medium text-slate-700">O tome una foto del código QR</span>
					<input id="foto-qr" type="file" accept="image/*" capture="environment"
						class="mt-1 block w-full rounded border border-slate-300 p-2 text-sm"/>
				</label>

				<p id="aviso-camara" class="mt-2 hidden text-sm text-amber-700"></p>
			</section>
		</div>

		<script src="/estaticos/js/jsqr.js" defer></script>
		<script>
			(function () {
				const video = document.getElementById('camara');
				const boton = document.getElementById('activar-camara');
				const aviso = document.getElementById('aviso-camara');
				const campo = document.getElementById('token');
				const formulario = document.getElementById('formulario-porteria');
				const entradaFoto = document.getElementById('foto-qr');
				const lienzo = document.createElement('canvas');

				const puedeUsarCamara = !!(navigator.mediaDevices && navigator.mediaDevices.getUserMedia);
				const contextoInseguro = !window.isSecureContext;

				let flujo = null;
				let detector = null;
				let animando = false;

				function avisar(texto) {
					aviso.textContent = texto;
					aviso.classList.remove('hidden');
				}

				function limpiarAviso() {
					aviso.classList.add('hidden');
				}

				function detenerCamara() {
					animando = false;
					if (flujo) {
						flujo.getTracks().forEach(function (pista) { pista.stop(); });
						flujo = null;
					}
					video.classList.add('hidden');
				}

				function registrar(codigo) {
					if (!codigo) return;
					campo.value = codigo.trim();
					detenerCamara();
					formulario.submit();
				}

				function crearDetector() {
					if (!('BarcodeDetector' in window)) return null;
					try {
						return new BarcodeDetector({ formats: ['qr_code'] });
					} catch (error) {
						return null;
					}
				}

				function decodificarLienzo(ancho, alto) {
					if (typeof window.jsQR !== 'function') return null;
					const contexto = lienzo.getContext('2d', { willReadFrequently: true });
					const imagen = contexto.getImageData(0, 0, ancho, alto);
					const resultado = window.jsQR(imagen.data, ancho, alto, { inversionAttempts: 'attemptBoth' });
					return resultado ? resultado.data : null;
				}

				async function leerCuadro() {
					if (!animando) return;
					let codigo = null;
					try {
						if (detector) {
							const codigos = await detector.detect(video);
							if (codigos.length > 0) codigo = codigos[0].rawValue;
						}
						if (!codigo && typeof window.jsQR === 'function' && video.videoWidth > 0) {
							lienzo.width = video.videoWidth;
							lienzo.height = video.videoHeight;
							lienzo.getContext('2d', { willReadFrequently: true }).drawImage(video, 0, 0, lienzo.width, lienzo.height);
							codigo = decodificarLienzo(lienzo.width, lienzo.height);
						}
					} catch (error) {
						codigo = null;
					}
					if (codigo) {
						registrar(codigo);
						return;
					}
					if (animando) setTimeout(leerCuadro, 200);
				}

				async function activarCamara() {
					limpiarAviso();
					if (!puedeUsarCamara || contextoInseguro) {
						avisar('La cámara en vivo no está disponible por HTTP. Use "Tomar foto del código QR" o un lector USB, o abra la página por HTTPS.');
						return;
					}
					try {
						flujo = await navigator.mediaDevices.getUserMedia({ video: { facingMode: { ideal: 'environment' } } });
						video.srcObject = flujo;
						video.classList.remove('hidden');
						await video.play();
						detector = crearDetector();
						animando = true;
						leerCuadro();
					} catch (error) {
						avisar('No se pudo activar la cámara. Revise los permisos del navegador o use "Tomar foto del código QR".');
					}
				}

				function cargarImagen(archivo) {
					if ('createImageBitmap' in window) {
						return createImageBitmap(archivo);
					}
					return new Promise(function (resolver, rechazar) {
						const imagen = new Image();
						imagen.onload = function () { resolver(imagen); };
						imagen.onerror = rechazar;
						imagen.src = URL.createObjectURL(archivo);
					});
				}

				async function leerFoto(archivo) {
					limpiarAviso();
					try {
						if (typeof window.jsQR !== 'function') {
							avisar('No se pudo cargar el lector de QR. Recargue la página o pegue el código manualmente.');
							return;
						}
						const imagen = await cargarImagen(archivo);
						lienzo.width = imagen.width;
						lienzo.height = imagen.height;
						lienzo.getContext('2d', { willReadFrequently: true }).drawImage(imagen, 0, 0, imagen.width, imagen.height);
						const codigo = decodificarLienzo(imagen.width, imagen.height);
						if (!codigo) {
							avisar('No se encontró un código QR en la imagen. Intente con más luz y el código centrado.');
							return;
						}
						registrar(codigo);
					} catch (error) {
						avisar('No se pudo leer la imagen. Intente de nuevo.');
					} finally {
						entradaFoto.value = '';
					}
				}

				boton.addEventListener('click', activarCamara);
				entradaFoto.addEventListener('change', function () {
					const archivo = entradaFoto.files && entradaFoto.files[0];
					if (archivo) leerFoto(archivo);
				});

				if (!puedeUsarCamara || contextoInseguro) {
					boton.classList.add('hidden');
					avisar('Para escanear en vivo desde este equipo abra la página por HTTPS. Mientras tanto, use "Tomar foto del código QR" o pegue el código.');
				}
			}());
		</script>
	}
}
