package vista

import (
	"asistencia/web/plantillas/paginas"
)

templ Grados(usuario string, rol string, tokenCSRF string, activo *AnioVista, grados []GradoVista, nombre string, mensaje string, mensajeError string) {
	@paginas.BaseSesion("Grados", usuario, rol, tokenCSRF) {
		<div class="flex flex-wrap items-center justify-between gap-3">
			<div>
				<a href="/configuracion" class="text-sm font-medium text-blue-700">← Configuración</a>
				<h1 class="mt-1 text-2xl font-semibold">Grados</h1>
				if activo != nil {
					<p class="text-sm text-slate-600">Año { activo.Nombre }</p>
				}
			</div>
		</div>

		if mensaje != "" {
			<p role="status" class="mt-4 rounded bg-green-100 p-3 text-green-800">{ mensaje }</p>
		}
		if mensajeError != "" {
			<p role="alert" class="mt-4 rounded bg-red-100 p-3 text-red-800">{ mensajeError }</p>
		}

		if activo == nil {
			<div class="mt-6 rounded border border-amber-200 bg-amber-50 p-4">
				<p class="text-amber-900">No hay un año escolar activo. Cree el año antes de registrar grados.</p>
				<a href="/configuracion/anio" class="mt-3 inline-block rounded bg-blue-700 px-4 py-2 font-semibold text-white">Ir al año escolar</a>
			</div>
		} else {
			<form method="post" action="/configuracion/grados" class="mt-6 grid gap-4 rounded border border-slate-200 bg-white p-4 sm:grid-cols-2">
				<input type="hidden" name="token_csrf" value={ tokenCSRF }/>
				<label class="block">
					<span class="text-sm font-medium">Nombre del grado *</span>
					<input type="text" name="nombre" value={ nombre } required placeholder="3.°" class="mt-1 w-full rounded border border-slate-300 p-2"/>
				</label>
				<div class="flex items-end">
					<button type="submit" class="rounded bg-blue-700 px-4 py-2 font-semibold text-white">Agregar grado</button>
				</div>
			</form>

			<h2 class="mt-8 text-lg font-semibold">Grados del año { activo.Nombre }</h2>
			if len(grados) == 0 {
				<p class="mt-2 text-slate-600">Todavía no hay grados registrados.</p>
			} else {
				<ul class="mt-3 grid gap-2 sm:grid-cols-2 lg:grid-cols-3">
					for _, grado := range grados {
						<li class="rounded border border-slate-200 bg-white p-3 font-medium">{ grado.Nombre }</li>
					}
				</ul>
			}
		}
	}
}
