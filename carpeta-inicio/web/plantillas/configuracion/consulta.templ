package vista

import (
	"asistencia/internal/plataforma/fechas"
	"asistencia/web/plantillas/paginas"
)

templ Consulta(usuario string, rol string, tokenCSRF string, fecha string, anio *AnioVista, horarios []HorarioVista, excepciones []ExcepcionVista, umbrales []UmbralVista, secciones []SeccionVista, bloques []BloqueVista) {
	@paginas.BaseSesion("Consulta histórica", usuario, rol, tokenCSRF) {
		<div class="flex flex-wrap items-center justify-between gap-3">
			<div>
				<a href="/configuracion" class="text-sm font-medium text-blue-700">← Configuración</a>
				<h1 class="mt-1 text-2xl font-semibold">Consulta histórica</h1>
				<p class="mt-1 text-sm text-slate-600">Configuración vigente en la fecha seleccionada.</p>
			</div>
		</div>

		<form method="get" action="/configuracion/consulta" class="mt-6 grid gap-3 rounded border border-slate-200 bg-white p-4 sm:grid-cols-3">
			<label class="block">
				<span class="text-sm font-medium">Fecha</span>
				<input type="date" name="fecha" value={ fecha } class="mt-1 w-full rounded border border-slate-300 p-2"/>
			</label>
			<div class="flex items-end">
				<button type="submit" class="rounded bg-blue-700 px-4 py-2 font-semibold text-white">Consultar</button>
			</div>
		</form>

		if anio == nil {
			<p role="alert" class="mt-6 rounded bg-amber-100 p-3 text-amber-900">
				No hay configuración vigente para la fecha seleccionada.
			</p>
		} else {
			<div class="mt-6 rounded border border-slate-200 bg-white p-4">
				<p class="font-medium">Año { anio.Nombre } · <span class="text-slate-600">{ anio.Estado }</span></p>
			</div>

			<h2 class="mt-8 text-lg font-semibold">Horarios por turno</h2>
			if len(horarios) == 0 {
				<p class="mt-2 text-slate-600">No había horarios configurados en esa fecha.</p>
			} else {
				<div class="mt-3 overflow-x-auto rounded border border-slate-200 bg-white">
					<table class="w-full text-left text-sm">
						<thead class="bg-slate-100 text-slate-700">
							<tr>
								<th class="p-3">Turno</th>
								<th class="p-3">Ingreso</th>
								<th class="p-3">Tolerancia</th>
								<th class="p-3">Límite de tardanza</th>
								<th class="p-3">Cierre</th>
								<th class="p-3">Vigente desde</th>
							</tr>
						</thead>
						<tbody>
							for _, horario := range horarios {
								<tr class="border-t border-slate-100">
									<td class="p-3 font-medium">{ etiquetaTurno(horario.Turno) }</td>
									<td class="p-3">{ horario.HoraIngreso }</td>
									<td class="p-3">{ horario.ToleranciaMinutos } min</td>
									<td class="p-3">{ horario.HoraLimiteTardanza }</td>
									<td class="p-3">{ horario.HoraCierre }</td>
									<td class="p-3">{ fechas.FormatearDia(horario.VigenteDesde) }</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			}

			<h2 class="mt-8 text-lg font-semibold">Excepciones del día</h2>
			if len(excepciones) == 0 {
				<p class="mt-2 text-slate-600">No había excepciones de calendario.</p>
			} else {
				<ul class="mt-3 space-y-2">
					for _, excepcion := range excepciones {
						<li class="rounded border border-slate-200 bg-white p-3">
							<span class="font-medium">{ excepcion.Tipo }</span> · { excepcion.Motivo }
							<span class="block text-sm text-slate-600">Alcance: { excepcion.Grados }</span>
						</li>
					}
				</ul>
			}

			<h2 class="mt-8 text-lg font-semibold">Umbrales vigentes</h2>
			if len(umbrales) == 0 {
				<p class="mt-2 text-slate-600">No había umbrales configurados.</p>
			} else {
				<ul class="mt-3 grid gap-2 sm:grid-cols-2">
					for _, umbral := range umbrales {
						<li class="rounded border border-slate-200 bg-white p-3">
							<span class="font-medium">{ umbral.Tipo }</span>: { umbral.Valor }
						</li>
					}
				</ul>
			}

			<h2 class="mt-8 text-lg font-semibold">Turno de las secciones</h2>
			if len(secciones) == 0 {
				<p class="mt-2 text-slate-600">No había secciones registradas.</p>
			} else {
				<div class="mt-3 overflow-x-auto rounded border border-slate-200 bg-white">
					<table class="w-full text-left text-sm">
						<thead class="bg-slate-100 text-slate-700">
							<tr>
								<th class="p-3">Grado</th>
								<th class="p-3">Sección</th>
								<th class="p-3">Turno</th>
							</tr>
						</thead>
						<tbody>
							for _, seccion := range secciones {
								<tr class="border-t border-slate-100">
									<td class="p-3 font-medium">{ seccion.Grado }</td>
									<td class="p-3">{ seccion.Nombre }</td>
									<td class="p-3">{ etiquetaTurno(seccion.Turno) }</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			}

			<h2 class="mt-8 text-lg font-semibold">Bloques de clase</h2>
			if len(bloques) == 0 {
				<p class="mt-2 text-slate-600">No había bloques configurados.</p>
			} else {
				<div class="mt-3 overflow-x-auto rounded border border-slate-200 bg-white">
					<table class="w-full text-left text-sm">
						<thead class="bg-slate-100 text-slate-700">
							<tr>
								<th class="p-3">Turno</th>
								<th class="p-3">Número</th>
								<th class="p-3">Inicio</th>
								<th class="p-3">Fin</th>
							</tr>
						</thead>
						<tbody>
							for _, bloque := range bloques {
								<tr class="border-t border-slate-100">
									<td class="p-3 font-medium">{ etiquetaTurno(bloque.Turno) }</td>
									<td class="p-3">{ bloque.Numero }</td>
									<td class="p-3">{ bloque.HoraInicio }</td>
									<td class="p-3">{ bloque.HoraFin }</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			}
		}
	}
}
