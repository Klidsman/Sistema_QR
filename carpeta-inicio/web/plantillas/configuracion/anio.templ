package vista

import (
	"asistencia/internal/plataforma/fechas"
	"asistencia/web/plantillas/paginas"
)

templ Anio(usuario string, rol string, tokenCSRF string, activo *AnioVista, anios []AnioVista, nombre string, mensaje string, mensajeError string) {
	@paginas.BaseSesion("Año escolar", usuario, rol, tokenCSRF) {
		<div class="flex flex-wrap items-center justify-between gap-3">
			<div>
				<a href="/configuracion" class="text-sm font-medium text-blue-700">← Configuración</a>
				<h1 class="mt-1 text-2xl font-semibold">Año escolar</h1>
			</div>
		</div>

		if mensaje != "" {
			<p role="status" class="mt-4 rounded bg-green-100 p-3 text-green-800">{ mensaje }</p>
		}
		if mensajeError != "" {
			<p role="alert" class="mt-4 rounded bg-red-100 p-3 text-red-800">{ mensajeError }</p>
		}

		if activo != nil {
			<div class="mt-6 rounded border border-slate-200 bg-white p-4">
				<h2 class="text-lg font-semibold">Año activo</h2>
				<dl class="mt-3 grid gap-3 sm:grid-cols-3">
					<div>
						<dt class="text-sm text-slate-500">Nombre</dt>
						<dd class="font-medium">{ activo.Nombre }</dd>
					</div>
					<div>
						<dt class="text-sm text-slate-500">Fecha de inicio</dt>
						<dd class="font-medium">{ fechas.FormatearDia(activo.FechaInicio) }</dd>
					</div>
					<div>
						<dt class="text-sm text-slate-500">Fecha de fin</dt>
						<dd class="font-medium">{ fechas.FormatearDia(activo.FechaFin) }</dd>
					</div>
				</dl>
				<form method="post" action="/configuracion/anio/cierre" class="mt-4" onsubmit="return confirm('Al cerrar el año no se podrán hacer cambios. ¿Continuar?');">
					<input type="hidden" name="token_csrf" value={ tokenCSRF }/>
					<button type="submit" class="rounded bg-amber-700 px-4 py-2 font-semibold text-white">Cerrar año escolar</button>
				</form>
			</div>
		} else {
			<h2 class="mt-6 text-lg font-semibold">Crear año escolar</h2>
			<form method="post" action="/configuracion/anio" class="mt-3 grid gap-4 rounded border border-slate-200 bg-white p-4 sm:grid-cols-3">
				<input type="hidden" name="token_csrf" value={ tokenCSRF }/>
				<label class="block">
					<span class="text-sm font-medium">Nombre del año *</span>
					<input type="text" name="nombre" value={ nombre } required placeholder="2027" class="mt-1 w-full rounded border border-slate-300 p-2"/>
				</label>
				<label class="block">
					<span class="text-sm font-medium">Fecha de inicio *</span>
					<input type="date" name="fecha_inicio" required class="mt-1 w-full rounded border border-slate-300 p-2"/>
				</label>
				<label class="block">
					<span class="text-sm font-medium">Fecha de fin *</span>
					<input type="date" name="fecha_fin" required class="mt-1 w-full rounded border border-slate-300 p-2"/>
				</label>
				<div class="sm:col-span-3">
					<button type="submit" class="rounded bg-blue-700 px-4 py-2 font-semibold text-white">Guardar año</button>
				</div>
			</form>
		}

		<h2 class="mt-8 text-lg font-semibold">Historial de años</h2>
		if len(anios) == 0 {
			<p class="mt-2 text-slate-600">Todavía no hay años escolares registrados.</p>
		} else {
			<div class="mt-3 overflow-x-auto rounded border border-slate-200 bg-white">
				<table class="w-full text-left text-sm">
					<thead class="bg-slate-100 text-slate-700">
						<tr>
							<th class="p-3">Nombre</th>
							<th class="p-3">Inicio</th>
							<th class="p-3">Fin</th>
							<th class="p-3">Estado</th>
						</tr>
					</thead>
					<tbody>
						for _, anio := range anios {
							<tr class="border-t border-slate-100">
								<td class="p-3 font-medium">{ anio.Nombre }</td>
								<td class="p-3">{ fechas.FormatearDia(anio.FechaInicio) }</td>
								<td class="p-3">{ fechas.FormatearDia(anio.FechaFin) }</td>
								<td class="p-3">{ anio.Estado }</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
	}
}
