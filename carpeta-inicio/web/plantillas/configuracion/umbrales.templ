package vista

import (
	"fmt"

	"asistencia/internal/plataforma/fechas"
	"asistencia/web/plantillas/paginas"
)

templ Umbrales(usuario string, rol string, tokenCSRF string, activo *AnioVista, tardanzas *UmbralVista, faltas *UmbralVista, faltasSeguidas *UmbralVista, historial []UmbralVista, formulario FormularioUmbral, mensaje string, mensajeError string) {
	@paginas.BaseSesion("Umbrales de alerta", usuario, rol, tokenCSRF) {
		<div class="flex flex-wrap items-center justify-between gap-3">
			<div>
				<a href="/configuracion" class="text-sm font-medium text-blue-700">← Configuración</a>
				<h1 class="mt-1 text-2xl font-semibold">Umbrales de alerta</h1>
				if activo != nil {
					<p class="text-sm text-slate-600">Año { activo.Nombre }</p>
				}
			</div>
		</div>

		if mensaje != "" {
			<p role="status" class="mt-4 rounded bg-green-100 p-3 text-green-800">{ mensaje }</p>
		}
		if mensajeError != "" {
			<p role="alert" class="mt-4 rounded bg-red-100 p-3 text-red-800">{ mensajeError }</p>
		}

		if activo == nil {
			<div class="mt-6 rounded border border-amber-200 bg-amber-50 p-4">
				<p class="text-amber-900">No hay un año escolar activo. Cree el año antes de configurar umbrales.</p>
				<a href="/configuracion/anio" class="mt-3 inline-block rounded bg-blue-700 px-4 py-2 font-semibold text-white">Ir al año escolar</a>
			</div>
		} else {
			<div class="mt-6 grid gap-4 sm:grid-cols-2">
				@tarjetaUmbral("Tardanzas por mes", tardanzas)
				@tarjetaUmbral("Faltas por mes", faltas)
				@tarjetaUmbral("Faltas seguidas", faltasSeguidas)
			</div>

			if rol == "administrador" {
				<form method="post" action="/configuracion/umbrales" class="mt-6 grid gap-4 rounded border border-slate-200 bg-white p-4 sm:grid-cols-4">
					<input type="hidden" name="token_csrf" value={ tokenCSRF }/>
					<label class="block">
						<span class="text-sm font-medium">Tipo *</span>
						<select name="tipo" required class="mt-1 w-full rounded border border-slate-300 p-2">
							<option value="tardanzas" selected?={ formulario.Tipo != "faltas" && formulario.Tipo != "faltas_seguidas" }>Tardanzas</option>
							<option value="faltas" selected?={ formulario.Tipo == "faltas" }>Faltas por mes</option>
							<option value="faltas_seguidas" selected?={ formulario.Tipo == "faltas_seguidas" }>Faltas seguidas</option>
						</select>
					</label>
					<label class="block">
						<span class="text-sm font-medium">Valor *</span>
						<input type="number" name="valor" min="1" max="100" value={ formulario.Valor } required class="mt-1 w-full rounded border border-slate-300 p-2"/>
					</label>
					<label class="block">
						<span class="text-sm font-medium">Vigencia desde *</span>
						<input type="date" name="vigente_desde" value={ valorFecha(formulario.Fecha) } required class="mt-1 w-full rounded border border-slate-300 p-2"/>
					</label>
					<div class="flex items-end">
						<button type="submit" class="rounded bg-blue-700 px-4 py-2 font-semibold text-white">Guardar umbral</button>
					</div>
				</form>
			}

			<h2 class="mt-8 text-lg font-semibold">Historial de umbrales</h2>
			if len(historial) == 0 {
				<p class="mt-2 text-slate-600">Todavía no hay umbrales configurados.</p>
			} else {
				<div class="mt-3 overflow-x-auto rounded border border-slate-200 bg-white">
					<table class="w-full text-left text-sm">
						<thead class="bg-slate-100 text-slate-700">
							<tr>
								<th class="p-3">Tipo</th>
								<th class="p-3">Valor</th>
								<th class="p-3">Vigente desde</th>
							</tr>
						</thead>
						<tbody>
							for _, umbral := range historial {
								<tr class="border-t border-slate-100">
									<td class="p-3 font-medium">{ umbral.Tipo }</td>
									<td class="p-3">{ fmt.Sprintf("%d", umbral.Valor) }</td>
									<td class="p-3">{ fechas.FormatearDia(umbral.VigenteDesde) }</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			}
		}
	}
}

templ tarjetaUmbral(titulo string, umbral *UmbralVista) {
	<div class="rounded border border-slate-200 bg-white p-4">
		<h2 class="text-lg font-semibold">{ titulo }</h2>
		if umbral == nil {
			<p class="mt-1 text-sm text-slate-600">Sin configurar.</p>
		} else {
			<p class="mt-2 text-2xl font-semibold">{ fmt.Sprintf("%d", umbral.Valor) }</p>
			<p class="text-sm text-slate-600">Vigente desde { fechas.FormatearDia(umbral.VigenteDesde) }</p>
		}
	</div>
}

func valorFecha(fecha string) string {
	if fecha != "" {
		return fecha
	}
	return fechas.FormatearISO(fechas.Hoy())
}
