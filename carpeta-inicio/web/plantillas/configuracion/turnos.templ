package vista

import (
	"fmt"
	"strconv"

	"asistencia/internal/plataforma/fechas"
	"asistencia/web/plantillas/paginas"
)

templ Turnos(usuario string, rol string, tokenCSRF string, activo *AnioVista, manana *HorarioVista, tarde *HorarioVista, historial []HorarioVista, mensaje string, mensajeError string) {
	@paginas.BaseSesion("Turnos", usuario, rol, tokenCSRF) {
		<div class="flex flex-wrap items-center justify-between gap-3">
			<div>
				<a href="/configuracion" class="text-sm font-medium text-blue-700">← Configuración</a>
				<h1 class="mt-1 text-2xl font-semibold">Turnos</h1>
				if activo != nil {
					<p class="text-sm text-slate-600">Año { activo.Nombre }</p>
				}
			</div>
		</div>

		if mensaje != "" {
			<p role="status" class="mt-4 rounded bg-green-100 p-3 text-green-800">{ mensaje }</p>
		}
		if mensajeError != "" {
			<p role="alert" class="mt-4 rounded bg-red-100 p-3 text-red-800">{ mensajeError }</p>
		}

		if activo == nil {
			<div class="mt-6 rounded border border-amber-200 bg-amber-50 p-4">
				<p class="text-amber-900">No hay un año escolar activo. Cree el año antes de configurar horarios.</p>
				<a href="/configuracion/anio" class="mt-3 inline-block rounded bg-blue-700 px-4 py-2 font-semibold text-white">Ir al año escolar</a>
			</div>
		} else {
			<div class="mt-6 grid gap-4 lg:grid-cols-2">
				@tarjetaTurno("manana", "Mañana", manana, tokenCSRF)
				@tarjetaTurno("tarde", "Tarde", tarde, tokenCSRF)
			</div>

			<h2 class="mt-8 text-lg font-semibold">Historial de horarios</h2>
			if len(historial) == 0 {
				<p class="mt-2 text-slate-600">Todavía no hay horarios configurados.</p>
			} else {
				<div class="mt-3 overflow-x-auto rounded border border-slate-200 bg-white">
					<table class="w-full text-left text-sm">
						<thead class="bg-slate-100 text-slate-700">
							<tr>
								<th class="p-3">Turno</th>
								<th class="p-3">Ingreso</th>
								<th class="p-3">Tolerancia</th>
								<th class="p-3">Límite de tardanza</th>
								<th class="p-3">Cierre</th>
								<th class="p-3">Vigente desde</th>
							</tr>
						</thead>
						<tbody>
							for _, horario := range historial {
								<tr class="border-t border-slate-100">
									<td class="p-3 font-medium">{ etiquetaTurno(horario.Turno) }</td>
									<td class="p-3">{ horario.HoraIngreso }</td>
									<td class="p-3">{ horario.ToleranciaMinutos } min</td>
									<td class="p-3">{ horario.HoraLimiteTardanza }</td>
									<td class="p-3">{ horario.HoraCierre }</td>
									<td class="p-3">{ fechas.FormatearDia(horario.VigenteDesde) }</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			}
		}
	}
}

templ tarjetaTurno(turno string, etiqueta string, actual *HorarioVista, tokenCSRF string) {
	<div class="rounded border border-slate-200 bg-white p-4">
		<h2 class="text-lg font-semibold">Turno de { etiqueta }</h2>
		if actual == nil {
			<p class="mt-1 text-sm text-slate-600">Sin configurar.</p>
		} else {
			<dl class="mt-2 grid grid-cols-2 gap-2 text-sm">
				<div>
					<dt class="text-slate-500">Ingreso</dt>
					<dd class="font-medium">{ actual.HoraIngreso }</dd>
				</div>
				<div>
					<dt class="text-slate-500">Tolerancia</dt>
					<dd class="font-medium">{ actual.ToleranciaMinutos } min</dd>
				</div>
				<div>
					<dt class="text-slate-500">Límite de tardanza</dt>
					<dd class="font-medium">{ actual.HoraLimiteTardanza }</dd>
				</div>
				<div>
					<dt class="text-slate-500">Cierre</dt>
					<dd class="font-medium">{ actual.HoraCierre }</dd>
				</div>
				<div class="col-span-2">
					<dt class="text-slate-500">Vigente desde</dt>
					<dd class="font-medium">{ fechas.FormatearDia(actual.VigenteDesde) }</dd>
				</div>
			</dl>
		}

		<form method="post" action={ fmt.Sprintf("/configuracion/turnos/%s", turno) } class="mt-4 grid gap-3 sm:grid-cols-2">
			<input type="hidden" name="token_csrf" value={ tokenCSRF }/>
			<label class="block">
				<span class="text-sm font-medium">Hora de ingreso ({ etiqueta }) *</span>
				<input type="time" name="hora_ingreso" value={ ingresoDe(actual) } required class="mt-1 w-full rounded border border-slate-300 p-2"/>
			</label>
			<label class="block">
				<span class="text-sm font-medium">Tolerancia en minutos ({ etiqueta }) *</span>
				<input type="number" name="tolerancia_minutos" min="0" max="120" value={ toleranciaDe(actual) } required class="mt-1 w-full rounded border border-slate-300 p-2"/>
			</label>
			<label class="block">
				<span class="text-sm font-medium">Hora límite de tardanza ({ etiqueta }) *</span>
				<input type="time" name="hora_limite_tardanza" value={ limiteDe(actual) } required class="mt-1 w-full rounded border border-slate-300 p-2"/>
			</label>
			<label class="block">
				<span class="text-sm font-medium">Hora de cierre ({ etiqueta }) *</span>
				<input type="time" name="hora_cierre" value={ cierreDe(actual) } required class="mt-1 w-full rounded border border-slate-300 p-2"/>
			</label>
			<label class="block sm:col-span-2">
				<span class="text-sm font-medium">Vigencia desde ({ etiqueta }) *</span>
				<input type="date" name="vigente_desde" value={ fechas.FormatearISO(fechas.Hoy()) } required class="mt-1 w-full rounded border border-slate-300 p-2"/>
			</label>
			<div class="sm:col-span-2">
				<button type="submit" class="rounded bg-blue-700 px-4 py-2 font-semibold text-white">Guardar horario</button>
			</div>
		</form>
	</div>
}

func ingresoDe(horario *HorarioVista) string {
	if horario == nil {
		return ""
	}
	return horario.HoraIngreso
}

func toleranciaDe(horario *HorarioVista) string {
	if horario == nil {
		return "10"
	}
	return strconv.Itoa(horario.ToleranciaMinutos)
}

func limiteDe(horario *HorarioVista) string {
	if horario == nil {
		return ""
	}
	return horario.HoraLimiteTardanza
}

func cierreDe(horario *HorarioVista) string {
	if horario == nil {
		return ""
	}
	return horario.HoraCierre
}
