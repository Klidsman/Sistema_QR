package vista

import (
	"fmt"
	"strconv"

	"asistencia/internal/plataforma/fechas"
	"asistencia/web/plantillas/paginas"
)

templ Secciones(usuario string, rol string, tokenCSRF string, activo *AnioVista, grados []GradoVista, secciones []SeccionVista, nombre string, mensaje string, mensajeError string) {
	@paginas.BaseSesion("Secciones", usuario, rol, tokenCSRF) {
		<div class="flex flex-wrap items-center justify-between gap-3">
			<div>
				<a href="/configuracion" class="text-sm font-medium text-blue-700">← Configuración</a>
				<h1 class="mt-1 text-2xl font-semibold">Secciones</h1>
				if activo != nil {
					<p class="text-sm text-slate-600">Año { activo.Nombre }</p>
				}
			</div>
		</div>

		if mensaje != "" {
			<p role="status" class="mt-4 rounded bg-green-100 p-3 text-green-800">{ mensaje }</p>
		}
		if mensajeError != "" {
			<p role="alert" class="mt-4 rounded bg-red-100 p-3 text-red-800">{ mensajeError }</p>
		}

		if activo == nil {
			<div class="mt-6 rounded border border-amber-200 bg-amber-50 p-4">
				<p class="text-amber-900">No hay un año escolar activo. Cree el año antes de registrar secciones.</p>
				<a href="/configuracion/anio" class="mt-3 inline-block rounded bg-blue-700 px-4 py-2 font-semibold text-white">Ir al año escolar</a>
			</div>
		} else if len(grados) == 0 {
			<div class="mt-6 rounded border border-amber-200 bg-amber-50 p-4">
				<p class="text-amber-900">El año no tiene grados. Cree al menos un grado antes de registrar secciones.</p>
				<a href="/configuracion/grados" class="mt-3 inline-block rounded bg-blue-700 px-4 py-2 font-semibold text-white">Ir a grados</a>
			</div>
		} else {
			<form method="post" action="/configuracion/secciones" class="mt-6 grid gap-4 rounded border border-slate-200 bg-white p-4 sm:grid-cols-2 lg:grid-cols-5">
				<input type="hidden" name="token_csrf" value={ tokenCSRF }/>
				<label class="block">
					<span class="text-sm font-medium">Grado *</span>
					<select name="grado_id" required class="mt-1 w-full rounded border border-slate-300 p-2">
						<option value="">Seleccione un grado</option>
						for _, grado := range grados {
							<option value={ strconv.FormatInt(grado.ID, 10) }>{ grado.Nombre }</option>
						}
					</select>
				</label>
				<label class="block">
					<span class="text-sm font-medium">Nombre de la sección *</span>
					<input type="text" name="nombre" value={ nombre } required placeholder="A" class="mt-1 w-full rounded border border-slate-300 p-2"/>
				</label>
				<label class="block">
					<span class="text-sm font-medium">Turno *</span>
					<select name="turno" required class="mt-1 w-full rounded border border-slate-300 p-2">
						<option value={ "manana" }>Mañana</option>
						<option value={ "tarde" }>Tarde</option>
					</select>
				</label>
				<label class="block">
					<span class="text-sm font-medium">Vigencia desde *</span>
					<input type="date" name="vigente_desde" value={ fechas.FormatearISO(fechas.Hoy()) } required class="mt-1 w-full rounded border border-slate-300 p-2"/>
				</label>
				<div class="flex items-end">
					<button type="submit" class="rounded bg-blue-700 px-4 py-2 font-semibold text-white">Agregar sección</button>
				</div>
			</form>

			<h2 class="mt-8 text-lg font-semibold">Secciones del año { activo.Nombre }</h2>
			if len(secciones) == 0 {
				<p class="mt-2 text-slate-600">Todavía no hay secciones registradas.</p>
			} else {
				<div class="mt-3 overflow-x-auto rounded border border-slate-200 bg-white">
					<table class="w-full text-left text-sm">
						<thead class="bg-slate-100 text-slate-700">
							<tr>
								<th class="p-3">Grado</th>
								<th class="p-3">Sección</th>
								<th class="p-3">Turno vigente</th>
								<th class="p-3">Cambiar turno</th>
							</tr>
						</thead>
						<tbody>
							for _, seccion := range secciones {
								<tr class="border-t border-slate-100 align-top">
									<td class="p-3 font-medium">{ seccion.Grado }</td>
									<td class="p-3">{ seccion.Nombre }</td>
									<td class="p-3">{ etiquetaTurno(seccion.Turno) }</td>
									<td class="p-3">
										<form method="post" action={ fmt.Sprintf("/configuracion/secciones/%d/turno", seccion.ID) } class="flex flex-wrap items-end gap-2">
											<input type="hidden" name="token_csrf" value={ tokenCSRF }/>
											<label class="block">
												<span class="text-xs text-slate-500">Turno</span>
												<select name="turno" class="rounded border border-slate-300 p-1">
													<option value={ "manana" }>Mañana</option>
													<option value={ "tarde" }>Tarde</option>
												</select>
											</label>
											<label class="block">
												<span class="text-xs text-slate-500">Desde</span>
												<input type="date" name="vigente_desde" value={ fechas.FormatearISO(fechas.Hoy()) } class="rounded border border-slate-300 p-1"/>
											</label>
											<button type="submit" class="rounded border border-slate-300 px-3 py-1 font-medium">Cambiar</button>
										</form>
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			}
		}
	}
}

func etiquetaTurno(turno string) string {
	switch turno {
	case "manana":
		return "Mañana"
	case "tarde":
		return "Tarde"
	default:
		return "Sin turno"
	}
}
