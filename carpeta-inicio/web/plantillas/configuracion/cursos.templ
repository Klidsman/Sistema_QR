package vista

import (
	"fmt"

	"asistencia/web/plantillas/paginas"
)

templ Cursos(usuario string, rol string, tokenCSRF string, activo *AnioVista, grados []GradoOpcion, cursos []CursoVista, mensaje string, mensajeError string) {
	@paginas.BaseSesion("Cursos", usuario, rol, tokenCSRF) {
		<div class="flex flex-wrap items-center justify-between gap-3">
			<div>
				<a href="/configuracion" class="text-sm font-medium text-blue-700">← Configuración</a>
				<h1 class="mt-1 text-2xl font-semibold">Cursos</h1>
				if activo != nil {
					<p class="text-sm text-slate-600">Año { activo.Nombre }</p>
				}
			</div>
		</div>

		if mensaje != "" {
			<p role="status" class="mt-4 rounded bg-green-100 p-3 text-green-800">{ mensaje }</p>
		}
		if mensajeError != "" {
			<p role="alert" class="mt-4 rounded bg-red-100 p-3 text-red-800">{ mensajeError }</p>
		}

		if activo == nil {
			<div class="mt-6 rounded border border-amber-200 bg-amber-50 p-4">
				<p class="text-amber-900">No hay un año escolar activo. Cree el año antes de registrar cursos.</p>
				<a href="/configuracion/anio" class="mt-3 inline-block rounded bg-blue-700 px-4 py-2 font-semibold text-white">Ir al año escolar</a>
			</div>
		} else if rol == "administrador" {
			<form method="post" action="/configuracion/cursos" class="mt-6 grid gap-4 rounded border border-slate-200 bg-white p-4">
				<input type="hidden" name="token_csrf" value={ tokenCSRF }/>
				<label class="block sm:max-w-md">
					<span class="text-sm font-medium">Nombre del curso *</span>
					<input type="text" name="nombre" required placeholder="Matemática" class="mt-1 w-full rounded border border-slate-300 p-2"/>
				</label>
				<fieldset>
					<legend class="text-sm font-medium">Grados vinculados *</legend>
					<div class="mt-2 flex flex-wrap gap-4">
						for _, grado := range grados {
							<label class="flex items-center gap-2">
								<input type="checkbox" name="grados" value={ fmt.Sprintf("%d", grado.ID) } class="h-4 w-4"/>
								<span>{ grado.Nombre }</span>
							</label>
						}
					</div>
				</fieldset>
				<div>
					<button type="submit" class="rounded bg-blue-700 px-4 py-2 font-semibold text-white">Agregar curso</button>
				</div>
			</form>
		}

		if activo != nil {
			<h2 class="mt-8 text-lg font-semibold">Cursos del año { activo.Nombre }</h2>
			if len(cursos) == 0 {
				<p class="mt-2 text-slate-600">Todavía no hay cursos registrados.</p>
			} else {
				<div class="mt-3 overflow-x-auto rounded border border-slate-200 bg-white">
					<table class="w-full text-left text-sm">
						<thead class="bg-slate-100 text-slate-700">
							<tr>
								<th class="p-3">Curso</th>
								<th class="p-3">Grados</th>
								<th class="p-3">Estado</th>
								if rol == "administrador" {
									<th class="p-3">Acciones</th>
								}
							</tr>
						</thead>
						<tbody>
							for _, curso := range cursos {
								<tr class="border-t border-slate-100">
									<td class="p-3 font-medium">{ curso.Nombre }</td>
									<td class="p-3">{ curso.Grados }</td>
									<td class="p-3">{ etiquetaEstadoCurso(curso.Activo) }</td>
									if rol == "administrador" {
										<td class="p-3">
											if curso.Activo {
												<form method="post" action={ fmt.Sprintf("/configuracion/cursos/%d/desactivacion", curso.ID) } onsubmit="return confirm('El curso dejará de poder asignarse, pero conservará su historial. ¿Continuar?');">
													<input type="hidden" name="token_csrf" value={ tokenCSRF }/>
													<button type="submit" class="rounded border border-amber-300 px-3 py-1 font-medium text-amber-800">Desactivar</button>
												</form>
											}
										</td>
									}
								</tr>
							}
						</tbody>
					</table>
				</div>
			}
		}
	}
}

func etiquetaEstadoCurso(activo bool) string {
	if activo {
		return "Activo"
	}
	return "Inactivo"
}
