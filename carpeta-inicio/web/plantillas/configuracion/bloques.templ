package vista

import (
	"fmt"

	"asistencia/internal/plataforma/fechas"
	"asistencia/web/plantillas/paginas"
)

templ Bloques(usuario string, rol string, tokenCSRF string, activo *AnioVista, turno string, bloques []BloqueVista, mensaje string, mensajeError string) {
	@paginas.BaseSesion("Bloques de clase", usuario, rol, tokenCSRF) {
		<div class="flex flex-wrap items-center justify-between gap-3">
			<div>
				<a href="/configuracion" class="text-sm font-medium text-blue-700">← Configuración</a>
				<h1 class="mt-1 text-2xl font-semibold">Bloques de clase</h1>
				if activo != nil {
					<p class="text-sm text-slate-600">Año { activo.Nombre }</p>
				}
			</div>
		</div>

		if mensaje != "" {
			<p role="status" class="mt-4 rounded bg-green-100 p-3 text-green-800">{ mensaje }</p>
		}
		if mensajeError != "" {
			<p role="alert" class="mt-4 rounded bg-red-100 p-3 text-red-800">{ mensajeError }</p>
		}

		if activo == nil {
			<div class="mt-6 rounded border border-amber-200 bg-amber-50 p-4">
				<p class="text-amber-900">No hay un año escolar activo. Cree el año antes de configurar bloques.</p>
				<a href="/configuracion/anio" class="mt-3 inline-block rounded bg-blue-700 px-4 py-2 font-semibold text-white">Ir al año escolar</a>
			</div>
		} else {
			<nav class="mt-6 flex gap-2" aria-label="Turno de los bloques">
				<a href="/configuracion/bloques?turno=manana" class={ claseTurno(turno == "manana") }>Mañana</a>
				<a href="/configuracion/bloques?turno=tarde" class={ claseTurno(turno == "tarde") }>Tarde</a>
			</nav>

			if rol == "administrador" {
				<form method="post" action="/configuracion/bloques" class="mt-4 grid gap-4 rounded border border-slate-200 bg-white p-4 sm:grid-cols-2 lg:grid-cols-5">
					<input type="hidden" name="token_csrf" value={ tokenCSRF }/>
					<input type="hidden" name="turno" value={ turno }/>
					<label class="block">
						<span class="text-sm font-medium">Número de bloque *</span>
						<input type="number" name="numero" min="1" max="20" required class="mt-1 w-full rounded border border-slate-300 p-2"/>
					</label>
					<label class="block">
						<span class="text-sm font-medium">Hora de inicio *</span>
						<input type="time" name="hora_inicio" required class="mt-1 w-full rounded border border-slate-300 p-2"/>
					</label>
					<label class="block">
						<span class="text-sm font-medium">Hora de fin *</span>
						<input type="time" name="hora_fin" required class="mt-1 w-full rounded border border-slate-300 p-2"/>
					</label>
					<label class="block">
						<span class="text-sm font-medium">Vigencia desde *</span>
						<input type="date" name="vigente_desde" value={ fechas.FormatearISO(fechas.Hoy()) } required class="mt-1 w-full rounded border border-slate-300 p-2"/>
					</label>
					<div class="flex items-end">
						<button type="submit" class="rounded bg-blue-700 px-4 py-2 font-semibold text-white">Agregar bloque</button>
					</div>
				</form>
			}

			<h2 class="mt-8 text-lg font-semibold">Bloques del turno de { etiquetaTurno(turno) }</h2>
			if len(bloques) == 0 {
				<p class="mt-2 text-slate-600">Todavía no hay bloques configurados para este turno.</p>
			} else {
				<div class="mt-3 overflow-x-auto rounded border border-slate-200 bg-white">
					<table class="w-full text-left text-sm">
						<thead class="bg-slate-100 text-slate-700">
							<tr>
								<th class="p-3">Número</th>
								<th class="p-3">Inicio</th>
								<th class="p-3">Fin</th>
								<th class="p-3">Vigente desde</th>
								<th class="p-3">Ajustar horas</th>
							</tr>
						</thead>
						<tbody>
							for _, bloque := range bloques {
								<tr class="border-t border-slate-100 align-top">
									<td class="p-3 font-medium">{ bloque.Numero }</td>
									<td class="p-3">{ bloque.HoraInicio }</td>
									<td class="p-3">{ bloque.HoraFin }</td>
									<td class="p-3">{ fechas.FormatearDia(bloque.VigenteDesde) }</td>
									<td class="p-3">
										<form method="post" action={ fmt.Sprintf("/configuracion/bloques/%d/horas", bloque.ID) } class="flex flex-wrap items-end gap-2">
											<input type="hidden" name="token_csrf" value={ tokenCSRF }/>
											<label class="block">
												<span class="text-xs text-slate-500">Inicio</span>
												<input type="time" name="hora_inicio" value={ bloque.HoraInicio } class="rounded border border-slate-300 p-1"/>
											</label>
											<label class="block">
												<span class="text-xs text-slate-500">Fin</span>
												<input type="time" name="hora_fin" value={ bloque.HoraFin } class="rounded border border-slate-300 p-1"/>
											</label>
											<label class="block">
												<span class="text-xs text-slate-500">Desde</span>
												<input type="date" name="vigente_desde" value={ fechas.FormatearISO(fechas.Hoy()) } class="rounded border border-slate-300 p-1"/>
											</label>
											<button type="submit" class="rounded border border-slate-300 px-3 py-1 font-medium">Ajustar</button>
										</form>
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			}
		}
	}
}

func claseTurno(activo bool) string {
	if activo {
		return "rounded bg-blue-700 px-4 py-2 font-semibold text-white"
	}
	return "rounded border border-slate-300 px-4 py-2 font-medium text-slate-700"
}
