package alertas

import "asistencia/web/plantillas/paginas"

templ IndicadorAlertas(datos Indicador) {
	<a id="indicador-alertas"
		href="/alertas"
		hx-get="/alertas/indicador"
		hx-trigger="every 60s"
		hx-swap="outerHTML"
		class="inline-flex items-center gap-2 rounded-full bg-blue-50 px-3 py-1 text-sm font-medium text-blue-800">
		Alertas nuevas
		<span class="rounded-full bg-blue-700 px-2 py-0.5 text-xs font-semibold text-white">{ numero(datos.Nuevas) }</span>
	</a>
}

templ PanelAlertas(datos Panel) {
	@paginas.BaseSesion("Alertas", datos.Nombre, datos.Rol, datos.TokenCSRF) {
		<div class="flex flex-wrap items-center justify-between gap-3">
			<h1 class="text-2xl font-semibold text-slate-900">Alertas</h1>
			if datos.EsAdmin {
				<a href="/alumnos" class="text-sm font-medium text-blue-700">Volver a alumnos</a>
			}
		</div>

		@IndicadorAlertas(Indicador{Nuevas: datos.Nuevas})

		if datos.Mensaje != "" {
			<p class="mt-4 rounded border border-emerald-200 bg-emerald-50 p-3 text-sm text-emerald-800">{ datos.Mensaje }</p>
		}

		<form method="get" action="/alertas" class="mt-4 grid gap-3 rounded border border-slate-200 bg-white p-4 sm:grid-cols-5">
			<label class="text-sm text-slate-700">
				Desde
				<input type="date" name="desde" value={ datos.Desde } class="mt-1 w-full rounded border border-slate-300 p-2"/>
			</label>
			<label class="text-sm text-slate-700">
				Hasta
				<input type="date" name="hasta" value={ datos.Hasta } class="mt-1 w-full rounded border border-slate-300 p-2"/>
			</label>
			<label class="text-sm text-slate-700">
				Tipo
				<select name="tipo" class="mt-1 w-full rounded border border-slate-300 p-2">
					<option value="">Todos</option>
					<option value="tardanza" selected?={ datos.Tipo == "tardanza" }>Tardanza</option>
					<option value="reiteracion_tardanzas" selected?={ datos.Tipo == "reiteracion_tardanzas" }>Reiteración de tardanzas</option>
					<option value="reiteracion_faltas" selected?={ datos.Tipo == "reiteracion_faltas" }>Faltas seguidas</option>
				</select>
			</label>
			<label class="text-sm text-slate-700">
				Estado
				<select name="estado" class="mt-1 w-full rounded border border-slate-300 p-2">
					<option value="">Todos</option>
					<option value="nueva" selected?={ datos.Estado == "nueva" }>Nuevas</option>
					<option value="vista" selected?={ datos.Estado == "vista" }>Vistas</option>
				</select>
			</label>
			<div class="flex items-end">
				<button type="submit" class="w-full rounded bg-blue-700 px-3 py-2 font-medium text-white">Filtrar</button>
			</div>
		</form>

		<form method="post" action="/alertas/vistas" class="mt-4">
			<input type="hidden" name="token_csrf" value={ datos.TokenCSRF }/>
			<input type="hidden" name="desde" value={ datos.Desde }/>
			<input type="hidden" name="hasta" value={ datos.Hasta }/>
			<input type="hidden" name="tipo" value={ datos.Tipo }/>
			<input type="hidden" name="estado" value={ datos.Estado }/>
			<div class="flex justify-end">
				<button type="submit" class="rounded border border-slate-300 px-3 py-1 text-sm font-medium text-slate-700">Marcar las mostradas como vistas</button>
			</div>

			<div class="mt-3 overflow-x-auto rounded border border-slate-200 bg-white">
				<table class="min-w-full divide-y divide-slate-200 text-sm">
					<thead class="bg-slate-50 text-left text-slate-600">
						<tr>
							<th class="p-3"></th>
							<th class="p-3">Alumno</th>
							<th class="p-3">Sección</th>
							<th class="p-3">Tipo</th>
							<th class="p-3">Fecha</th>
							<th class="p-3">Estado</th>
							<th class="p-3"></th>
						</tr>
					</thead>
					<tbody class="divide-y divide-slate-100">
						if len(datos.Alertas) == 0 {
							<tr>
								<td colspan="7" class="p-6 text-center text-slate-500">No hay alertas para los filtros elegidos.</td>
							</tr>
						}
						for _, alerta := range datos.Alertas {
							<tr class={ filaClase(alerta) }>
								<td class="p-3">
									if alerta.Nueva {
										<input type="checkbox" name="ids" value={ numero64(alerta.ID) }/>
									}
								</td>
								<td class="p-3 font-medium text-slate-900">
									{ alerta.Alumno }
									if alerta.SinResponsable {
										<span class="ml-2 rounded bg-amber-100 px-2 py-0.5 text-xs text-amber-800">Sin responsable</span>
									}
									if alerta.SituacionCambiada {
										<span class="ml-2 rounded bg-slate-100 px-2 py-0.5 text-xs text-slate-600">Situación cambiada</span>
									}
								</td>
								<td class="p-3 text-slate-700">{ alerta.Seccion }</td>
								<td class="p-3 text-slate-700">{ alerta.TipoEtiqueta }</td>
								<td class="p-3 text-slate-700">{ alerta.Fecha }</td>
								<td class="p-3 text-slate-700">{ alerta.Estado }</td>
								<td class="p-3 text-right">
									if alerta.Nueva {
										<button type="submit" formaction={ "/alertas/" + numero64(alerta.ID) + "/vista" } class="text-sm font-medium text-blue-700">Marcar vista</button>
									}
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		</form>
	}
}
