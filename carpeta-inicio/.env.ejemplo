# Copiar este archivo a .env y completar los valores. No versionar .env.

# Base de datos PostgreSQL (obligatorio). El contenedor de desarrollo usa el puerto 5433
# para no chocar con una instalación local de PostgreSQL en el 5432.
BASE_DATOS_URL=postgres://asistencia:cambiar_esta_clave@localhost:5433/asistencia?sslmode=disable

# Puerto HTTP de la aplicación
PUERTO=8080

# Clave para firmar y proteger las sesiones (obligatorio, mínimo 32 caracteres)
CLAVE_SESION=cambiar_por_una_clave_aleatoria_de_al_menos_32_caracteres

# Carné: tamaño en milímetros para la vista de impresión
CARNET_ANCHO_MM=85
CARNET_ALTO_MM=54

# Foto: tamaño máximo en megabytes (JPG o PNG)
FOTO_TAMANIO_MAXIMO_MB=2

# Importación: número máximo de filas por archivo
IMPORTACION_MAX_FILAS=5000

# Almacenamiento de fotos: disco (desarrollo) o s3 (producción)
ALMACENAMIENTO_TIPO=disco
ALMACENAMIENTO_RUTA=./datos/fotos

# Solo si ALMACENAMIENTO_TIPO=s3
ALMACENAMIENTO_BUCKET=
ALMACENAMIENTO_ENDPOINT=
ALMACENAMIENTO_CLAVE_ACCESO=
ALMACENAMIENTO_CLAVE_SECRETA=

# Administrador inicial (para "servidor crear-admin" y "servidor sembrar")
ADMIN_CORREO=
ADMIN_CONTRASENIA=
ADMIN_NOMBRE=Administrador

# Solo para "servidor sembrar": nombre del año escolar de demostración
ANIO_NOMBRE=
